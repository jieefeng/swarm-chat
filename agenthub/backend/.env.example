# AgentHub 环境变量配置

# 说明: 当前所有 LLM 调用均为本地模拟实现（services/mock_llm.py），
#       不发起任何真实网络请求，无需配置任何 LLM API Key。

# LLM 提供商选择: bailian / minimax（两者均指向模拟服务）
LLM_PROVIDER=bailian

# API Key for client authentication (可选)
API_KEY=dev-secret-key

# Redis 配置（可选，不配置则使用内存存储）
REDIS_URL=redis://localhost:6379
STORAGE_BACKEND=memory
MESSAGE_TTL_DAYS=30
MAX_MESSAGES=1000

# Claude Code 工具配置
CLAUDE_CODE_ENABLED=true
CLAUDE_CODE_TIMEOUT=300
CLAUDE_CODE_MODEL=
CLAUDE_CODE_MAX_TURNS=10
CLAUDE_CODE_MAX_ROUNDS=3

PORT=7010
